# ── Notion OAuth 연동 설정 (2번 방식: "Connect to Notion") ──────────────
# 이 값들은 위젯 제작자(당신) 한 명만 발급받으면 됩니다.
# 구매자는 이 값을 몰라도 되고, 위젯의 "Notion에 연결하기" 버튼만 누르면 됩니다.

# 1) https://www.notion.so/my-integrations → New integration
#    → Distribution 탭에서 "Public integration"으로 전환 후 아래 값 발급
NOTION_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_CLIENT_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) OAuth 콜백 URL. Public integration 설정 화면의 "Redirect URIs"에 정확히
#    동일한 값을 등록해야 함 (배포 도메인 기준으로 바꿀 것)
NOTION_REDIRECT_URI=http://localhost:3000/auth/notion/callback

# 3) 세션 쿠키 서명용 임의 문자열 (배포 전 반드시 변경)
SESSION_SECRET=change-this-to-a-random-string

# 4) 위젯이 임베드될 실제 도메인 (CORS)
ALLOWED_ORIGIN=https://your-widget-domain.com

PORT=3000
